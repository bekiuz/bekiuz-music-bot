# Copy these values into your hosting provider's environment settings.
# Never commit a real bot token to GitHub.
BOT_TOKEN=
YOUTUBE_API_KEY=
YOUTUBE_REGION=UZ
TTS_VOICE=uz-UZ-SardorNeural
MAX_INPUT_MB=8
MAX_DOWNLOAD_MB=35
MAX_VIDEO_MB=18
USER_COOLDOWN_SECONDS=3
# Leave blank to use imageio-ffmpeg when system FFmpeg is not installed.
FFMPEG_BIN=
LOG_LEVEL=INFO
